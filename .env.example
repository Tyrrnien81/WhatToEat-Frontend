# Copy to .env and adjust as needed.
#
# Production / staging (deployed API):
# EXPO_PUBLIC_API_BASE_URL=https://whattoeat-backend-wh34.onrender.com
#
# Local backend: set LAN IP + port, or omit EXPO_PUBLIC_API_BASE_URL so dev uses
# the same host as Expo Metro + :8000 (no manual IP).
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000

# Supabase (same project as the FastAPI backend — anon key is safe in the client).
# URL defaults in app.config.js to this repo’s Supabase project; override if needed.
# EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Required: anon public key from Dashboard → Settings → API
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Email confirmation / password reset links: add Redirect URLs in Supabase (Authentication → URL Configuration):
#   whattoeat://**          (custom scheme from app.json — production / dev client)
#   exp://**                (Expo Go; dev machine IP in URL — phone must reach Metro or link may fail)
# Optional: set Site URL to https://<project-ref>.supabase.co if you do not have a web app.

# iOS (Xcode / expo prebuild): 10-char Apple Developer Team ID — also set in Xcode → Signing & Capabilities.
# APPLE_TEAM_ID=XXXXXXXXXX
#
# Native Xcode (device builds): copy ios/WhatToEatApp.local.xcconfig.example → ios/WhatToEatApp.local.xcconfig
# and set DEVELOPMENT_TEAM=... (same ID). Simulator builds use local signing and should not require this.

# Optional: static JWT for API testing without signing in (overridden by session token when logged in).
# EXPO_PUBLIC_API_ACCESS_TOKEN=
# EXPO_PUBLIC_DEV_USER_ID=
